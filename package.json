{
  "name": "aik-vdgeneration",
  "version": "0.1.0",
  "private": true,
  "description": "AIK-VdGeneration Monorepo: Automated Prompt-to-Slide Video Presentation Platform",
  "scripts": {
    "generate": "python services/api-gateway/src/cli.py",
    "dev:api": "python -m uvicorn src.main:app --app-dir services/api-gateway --host 0.0.0.0 --port 8000 --reload",
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "worker": "python services/api-gateway/src/worker.py",
    "test:api": "python -m pytest services/api-gateway/tests/ -v",
    "test:video": "npm --prefix services/video-renderer test",
    "test:web": "npm --prefix apps/web test",
    "test:web:e2e": "npm --prefix apps/web run test:e2e",
    "typecheck:video": "npm --prefix services/video-renderer run typecheck",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "test": "npm run test:api && npm run typecheck:video && npm run test:video && npm run typecheck:web && npm run test:web"
  }
}
