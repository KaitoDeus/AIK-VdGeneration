# ==============================================================================
# AIK-VdGeneration: Root .gitignore
# Phân loại chi tiết cho Monorepo: Next.js Web, FastAPI, Remotion, Flutter & Media
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Môi trường & Bí mật bảo mật (Environment Variables & Secrets)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
# Giữ lại các tệp mẫu cấu hình (Allow example files)
!.env.example
!services/api-gateway/.env.example
!apps/web/.env.example

# Chứng chỉ & Khóa bảo mật (Certificates & Keys)
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 2. Đa phương tiện & Tệp tạm thời Render (Remotion, Video & Audio Pipeline)
# ------------------------------------------------------------------------------
# Remotion internal cache & bundles
.remotion/
services/video-renderer/.remotion/

# Video kết xuất (Rendered Video outputs)
*.mp4
*.webm
*.mov
*.avi
*.mkv
out/
exports/
public/renders/
services/video-renderer/out/

# Tệp âm thanh tạm thời & cache TTS (TTS Audio temp files)
*.mp3
*.wav
*.m4a
*.ogg
*.flac
*.aac
public/audio_temp/
temp_audio/
audio_cache/
services/video-renderer/public/audio_temp/

# Hình ảnh & tài nguyên tải tạm từ Unsplash / Pexels
public/stock_temp/
temp_images/
*.download

# Thư mục tạm thời chung
tmp/
temp/
.temp/
*.tmp

# ------------------------------------------------------------------------------
# 3. Node.js & Web Studio (apps/web, services/video-renderer)
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js & Build outputs
.next/
dist/
build/
*.tsbuildinfo
.turbo/

# Kiểm thử & Coverage
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# 4. Python & API Gateway (services/api-gateway)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Môi trường ảo (Virtual Environments)
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Packaging & Distribution
*.egg-info/
.eggs/
eggs/
*.egg
*.whl

# Kiểm thử Python & Linters
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ------------------------------------------------------------------------------
# 5. Mobile App Client (apps/mobile - Flutter / React Native)
# ------------------------------------------------------------------------------
# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
apps/mobile/android/.gradle/
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/

# Android / iOS binaries
*.apk
*.aab
*.dex
*.ipa

# ------------------------------------------------------------------------------
# 6. IDEs & Trình soạn thảo (Editors & Tools)
# ------------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.history/

# ------------------------------------------------------------------------------
# 7. Hệ điều hành (Operating System Files)
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Linux
.directory
.Trash-*

# Giữ lại tệp giữ chỗ thư mục trống (Preserve empty directories)
!.gitkeep
