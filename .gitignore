# ==============================================================================
# AIK-VdGeneration: Root .gitignore
# Multi-service monorepo: Next.js Web, FastAPI, Remotion, Flutter & Media Pipeline
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
*.env
# Allow configuration example templates
!.env.example
!services/api-gateway/.env.example
!apps/web/.env.example

# Certificates & Private Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 2. Media Assets & Temporary Renders (Remotion, Video & Audio Pipeline)
# ------------------------------------------------------------------------------
# Remotion internal cache & bundles
.remotion/
services/video-renderer/.remotion/

# Video outputs
*.mp4
*.webm
*.mov
*.avi
*.mkv
out/
exports/
public/renders/
services/video-renderer/out/

# Audio temporary files & TTS cache
*.mp3
*.wav
*.m4a
*.ogg
*.flac
*.aac
public/audio_temp/
temp_audio/
audio_cache/
services/video-renderer/public/audio_temp/

# Downloaded stock media caches (Unsplash / Pexels)
public/assets/
services/video-renderer/public/assets/
services/video-renderer/public/music/
public/stock_temp/
temp_images/
*.download

# General temporary directories
tmp/
temp/
.temp/
*.tmp

# ------------------------------------------------------------------------------
# 3. Node.js & Web Studio (apps/web, services/video-renderer)
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js & Build outputs
.next/
dist/
build/
*.tsbuildinfo
.turbo/

# Testing & Coverage
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# ------------------------------------------------------------------------------
# 4. Python & API Gateway (services/api-gateway)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Packaging & Distribution
*.egg-info/
.eggs/
eggs/
*.egg
*.whl

# Python Testing & Linters
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ------------------------------------------------------------------------------
# 5. Mobile App Client (apps/mobile - Flutter / React Native)
# ------------------------------------------------------------------------------
# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
apps/mobile/android/.gradle/
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/

# Android / iOS binaries
*.apk
*.aab
*.dex
*.ipa

# ------------------------------------------------------------------------------
# 6. IDEs & Editors
# ------------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.history/

# ------------------------------------------------------------------------------
# 7. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Linux
.directory
.Trash-*

# Preserve empty directory placeholders
!.gitkeep
