# Server Config
PORT=8000
ENVIRONMENT=development

# AI LLM Configuration (Google GenAI Interactions API >= 3.2.0)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-4-hydrogen
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Optional Secondary LLM Provider
OPENAI_API_KEY=your_openai_api_key_here

# TTS Voice Services (Edge-TTS, Gemini 3.8 TTS, ElevenLabs, FPT.AI)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
FPT_AI_API_KEY=your_fpt_ai_api_key_here

# Visual & Stock Media (Unsplash & Pexels - M2.3)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
PEXELS_API_KEY=your_pexels_api_key_here
STOCK_IMAGE_PROVIDER=auto # auto | unsplash | pexels | disabled

# Redis Queue & Worker Configuration (Phase 2 M2.1)
REDIS_URL=redis://localhost:6379/0
QUEUE_MODE=auto # auto | redis | memory
USE_EXTERNAL_WORKER=false
MAX_JOB_RETRIES=3

# Storage
STORAGE_PROVIDER=local # local | s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
