# Server Config
PORT=8000
ENVIRONMENT=development

# AI LLM Configuration (Google GenAI Interactions API >= 3.2.0)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-4-hydrogen
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Optional Secondary LLM Provider
OPENAI_API_KEY=your_openai_api_key_here

# TTS Voice Services (Edge-TTS, Gemini 3.8 TTS, ElevenLabs, FPT.AI)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
FPT_AI_API_KEY=your_fpt_ai_api_key_here

# Visual & Stock Media (Unsplash & Pexels - M2.3)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
PEXELS_API_KEY=your_pexels_api_key_here
STOCK_IMAGE_PROVIDER=auto # auto | unsplash | pexels | disabled

# Redis Queue & Worker Configuration (Phase 2 M2.1)
REDIS_URL=redis://localhost:6379/0
QUEUE_MODE=auto # auto | redis | memory
USE_EXTERNAL_WORKER=false
MAX_JOB_RETRIES=3

# Storage & CDN Delivery (M2.4: Local / AWS S3 / Cloudflare R2)
STORAGE_PROVIDER=auto # auto | local | s3 | r2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
R2_ACCOUNT_ID=
S3_ENDPOINT_URL=
CDN_PUBLIC_BASE_URL=
STORAGE_KEY_PREFIX=videos
SIGNED_URL_EXPIRY_SECONDS=3600

# Remotion Lambda Serverless Render Farm (M3.1)
RENDER_ENGINE=auto # auto | local | lambda
REMOTION_AWS_REGION=us-east-1
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_LAMBDA_SERVE_URL=
REMOTION_LAMBDA_MAX_CHUNKS=50
REMOTION_LAMBDA_TIMEOUT_SECONDS=240
REMOTION_LAMBDA_FALLBACK_TO_LOCAL=true

# Animated Subtitles / Whisper Timestamps (M3.3)
OPENAI_WHISPER_MODEL=whisper-1
SUBTITLE_PROVIDER=auto # auto | whisper | forced_alignment
