# Server Config
PORT=8000
ENVIRONMENT=development

# AI LLM Configuration (Google GenAI Interactions API >= 3.2.0)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-4-hydrogen
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Optional Secondary LLM Provider
OPENAI_API_KEY=your_openai_api_key_here

# TTS Voice Services (Edge-TTS, Gemini 3.8 TTS, ElevenLabs, FPT.AI)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
FPT_AI_API_KEY=your_fpt_ai_api_key_here

# Redis Queue
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_PROVIDER=local # local | s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
